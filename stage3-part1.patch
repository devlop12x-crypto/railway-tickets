+    );
+  });
+
+  it('проверяет формат и порядок дат', () => {
+    expect(validateSearch(values({ dateThere: '31.02.2018' }), TODAY).dateThere).toBe(
+      'Дата в формате ДД.ММ.ГГГГ',
+    );
