+  });
+
+  it('сворачивает середину в «…»', () => {
+    expect(paginationRange(2, 10)).toEqual([1, 2, 3, 'gap', 10]);
+    expect(paginationRange(6, 10)).toEqual([1, 'gap', 5, 6, 7, 'gap', 10]);
